NODE_ENV=
PORT=
FRONTEND_URL=

DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=
DB_SYNCHRONIZE=true
DB_LOGGING=false

JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_SECURE=false

ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Tự động tổng hợp tin từ RSS chính thức mỗi 10 phút
NEWS_SYNC_ENABLED=true
NEWS_SYNC_ON_START=true
NEWS_SYNC_LIMIT_PER_FEED=12
NEWS_FETCH_TIMEOUT_MS=12000

# Bản tin email tự động lúc 07:00 (Asia/Ho_Chi_Minh)
NEWSLETTER_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
NEWSLETTER_FROM_NAME=Nhịp Tin
NEWSLETTER_FROM_EMAIL=
PUBLIC_API_URL=http://localhost:8081/api/v1
